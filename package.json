{
  "name": "overworld",
  "version": "0.9.0",
  "private": true,
  "description": "Overworld Engine — a modular, cross-platform 3D RPG systems framework for TypeScript",
  "keywords": [
    "typescript",
    "threejs",
    "react-three-fiber",
    "rpg",
    "game-framework",
    "cross-platform"
  ],
  "homepage": "https://overworldengine.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/luzhenqian/overworld.git"
  },
  "bugs": {
    "url": "https://github.com/luzhenqian/overworld/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "docs:dev": "pnpm --filter docs dev",
    "docs:check": "pnpm --filter docs check:content && pnpm --filter docs types:check",
    "docs:build": "pnpm --filter docs build",
    "docs:seo:indexnow": "node apps/docs/scripts/submit-indexnow.mjs",
    "docs:seo:live": "pnpm --filter docs check:live",
    "docs:seo": "pnpm --filter docs check:seo",
    "docs:start": "pnpm --filter docs start",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter './packages/*' build && changeset publish"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "dependency-cruiser": "^18.1.0",
    "jsdom": "^27.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18",
    "zustand": "^5.0.2"
  },
  "license": "MIT"
}
